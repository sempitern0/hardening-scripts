{
    # Non-privileged container listeners; host ports 80/443 are forwarded by Docker.
    admin off
    http_port 8080
    https_port 8443
    email {$ACME_EMAIL}
}

# The explicit redirect avoids leaking the container's internal HTTPS port (8443).
http://{$AUDIT_DOMAIN} {
    redir https://{$AUDIT_DOMAIN}{uri} 308
}

{$AUDIT_DOMAIN} {
    root * /srv
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "frame-ancestors 'none'"
    }

    # The app shell and service worker must never be served stale by HTTP caches.
    @shell path / /index.html /sw.js /manifest.webmanifest
    header @shell Cache-Control "no-store, must-revalidate"

    # The versioned service worker itself controls offline resources.
    @assets path /css/* /js/* /fonts/* /icons/*
    header @assets Cache-Control "public, max-age=300, must-revalidate"

    # No SPA catch-all: missing JS/CSS must fail with 404, never return index.html.
    file_server
}
